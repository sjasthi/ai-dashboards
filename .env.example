# Copy this file to .env and fill in your own values.
# .env is gitignored, so each teammate keeps their own copy locally.

# "ollama" (default) uses your local Ollama install with qwen2.5.
# "groq" uses the Groq API instead (falls back to Ollama automatically
# if GROQ_API_KEY is missing or a Groq request fails).
AI_BACKEND=groq

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the default Groq model
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: model to try if GROQ_MODEL hits its daily rate limit (each Groq
# model has its own separate free-tier quota)
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Optional third tier, tried after both Groq models and before local Ollama.
# Separate account from Groq, so its free quota survives Groq's daily limit.
# Leave blank to skip the tier entirely. Free key (no card) at
# https://aistudio.google.com/apikey - check your current free-tier RPD there too,
# Google has been changing it.
GEMINI_API_KEY=

# Optional: override the default Gemini model
# GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: number of validation-failure retries. Each retry is a full extra
# generation, so it costs more of the hosted daily/hourly quota. Default 0.
# LLM_MAX_RETRIES=1

# SMTP settings for the Reports page's "Email to" export. Leave SMTP_HOST blank to
# leave the feature off - the export panel then disables the email row and says why,
# and PDF/HTML downloads still work.
#
# Mailtrap sells two different products and they behave differently. Use its SMTP
# credentials, not its Python SDK - the SDK would need a new dependency and a rewrite
# of emailer.py for no gain.
#
#       Email Testing / Sandbox - captures every message and delivers NOTHING. Any
#       recipient address works, so it's the right choice while building: you get a
#       web inbox to open the PDF from. Credentials are per-sandbox, under
#       Email Testing -> your inbox -> Integration -> SMTP.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=<sandbox username>
SMTP_PASSWORD=<sandbox password>
SMTP_FROM=ai-dashboard@example.com   # anything - the sandbox delivers nothing



# Usage tracking (app/data/telemetry.py). Both optional.
#
# Where the SQLite usage database lives. Defaults to usage.db at the repo root,
# which is gitignored. Point it elsewhere to keep it outside the working tree.
# TELEMETRY_DB=usage.db
#
# Store filenames and column names in plaintext instead of as a 12-char sha256
# prefix. Off by default: shapes and counts answer every question the home page
# asks without holding anyone's data. Turn it on while developing when you need
# to tell which row came from which upload.
# TELEMETRY_STORE_NAMES=1


# Developer report browser (app/data/session_store.py). Both optional, both off.
#
# Save each analysis to session_data/<session_id>/ as source/<the uploaded files>
# plus manifest.json, so a past report can be re-opened later WITHOUT re-uploading
# and without spending another LLM call. Off by default because it retains the whole
# workbook the user uploaded - every sheet, every row - on this machine, with no
# pruning. session_data/ is gitignored, but it is still real user data: turn this on
# for development, and delete session_data/<id>/ to forget one run.
# SAVE_REPORT_HISTORY=true
#
# Shared secret for the GET /api/admin/* routes that list and replay those sessions.
# Leave it unset and the routes 404 - an unconfigured deployment shouldn't advertise
# that they exist. Set it and a wrong or missing X-Admin-Token gets 401.
# ADMIN_TOKEN=<any long random string>


# Write per-run debug artifacts to session_data/<session_id>/: the raw and cleaned
# LLM responses, plus a report-generation trace per report. Off by default so a
# normal run leaves nothing behind. Turn this on before using
# scripts/replay_report.py - it replays cleaned_response.json and has no input
# without it.
# SAVE_DEBUG_FILES=true
