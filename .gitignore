# Python
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd

# Virtual envs
ai-env/
.venv/
venv/
.env/
.env

# Editor/OS
.vscode/
*.swp
Thumbs.db
.DS_Store

# Node (if web folder)
node_modules/
dist/
build/

# Session data
session_data/

# Test output
test_results/

# Usage tracking database. The -wal and -shm siblings are created by
# PRAGMA journal_mode=WAL and are just as machine-local as the .db itself.
usage.db
usage.db-wal
usage.db-shm

# Ad-hoc test corpus. Developers drop spreadsheets here to have them checked;
# the files are theirs and may be large or private, so nothing but the README
# is tracked. Recorded expectations for these live in inbox/baseline.json and
# are ignored by the same rule - the committed tests/data/baseline.json must
# only describe files everyone actually has.
tests/data/inbox/*
!tests/data/inbox/README.md